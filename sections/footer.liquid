{% render 'section-appearance', section: section %}
<section class="vx-shell vx-shell--loading" data-vx-section="footer" data-vx-footer>
  <div class="vx-editor-preview"></div>
</section>

<script type="application/json" data-vx-settings="footer">
{
  "logo_url": {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: height: 80 | json }}{% else %}null{% endif %},
  "logo_height": {{ section.settings.logo_height | default: 40 }},
  "brand_text": {{ section.settings.brand_text | default: shop.name | json }},
  "brand_font_size": {{ section.settings.brand_font_size | default: 24 }},
  "brand_color": {{ section.settings.brand_color | default: '#ffffff' | json }},
  "show_policies": {{ section.settings.show_policies | json }},
  "label_refund": {{ section.settings.refund_policy_label | default: 'Refund Policy' | json }},
  "label_shipping": {{ section.settings.label_shipping | default: 'Shipping' | json }},
  "label_privacy": {{ section.settings.label_privacy | default: 'Privacy' | json }},
  "label_terms": {{ section.settings.label_terms | default: 'Terms' | json }},
  "link_gap": {{ section.settings.link_gap | default: 24 }},
  "instagram_url": {{ section.settings.instagram_url | default: '' | json }},
  "tiktok_url": {{ section.settings.tiktok_url | default: '' | json }},
  "youtube_url": {{ section.settings.youtube_url | default: '' | json }},
  "discord_url": {{ section.settings.discord_url | default: '' | json }},
  "social_icon_color": {{ section.settings.social_icon_color | default: '#19d400' | json }},
  "social_icon_size": {{ section.settings.social_size | default: 22 }},
  "show_cta": {{ section.settings.show_cta | json }},
  "cta_text": {{ section.settings.cta_text | default: 'Get this store design' | json }},
  "cta_url": {{ section.settings.cta_url | default: 'https://vexelthemes.com' | json }},
  "cta_color": {{ section.settings.cta_color | default: '#19d400' | json }},
  "cta_text_color": {{ section.settings.cta_text_color | default: '#1a1a1a' | json }},
  "cta_radius": {{ section.settings.cta_radius | default: 12 }},
  "show_copyright": {{ section.settings.show_copyright | json }},
  "copyright_name": {{ section.settings.copyright_name | default: shop.name | json }},
  "bg_color": {{ section.settings.bg_color | default: '#000000' | json }},
  "border_color": {{ section.settings.border_color | default: '#1a1a1a' | json }},
  "link_color": {{ section.settings.link_color | default: '#6b7280' | json }},
  "link_hover_color": {{ section.settings.link_hover_color | default: '#ffffff' | json }},
  "copyright_color": {{ section.settings.copyright_color | default: '#6b7280' | json }},
  "content_gap": {{ section.settings.content_gap | default: 24 }},
  "bottom_gap": {{ section.settings.bottom_gap | default: 12 }},
  "padding_top": {{ section.settings.padding_top | default: 40 }},
  "padding_bottom": {{ section.settings.padding_bottom | default: 40 }}
}
</script>

<style>.vx-shell[data-vx-section="footer"]{min-height:120px}</style>

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (px)",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 40
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text (if no logo)",
      "default": "OGSELL"
    },
    {
      "type": "range",
      "id": "brand_font_size",
      "label": "Brand text size (px)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Policy links"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "text",
      "id": "refund_policy_label",
      "label": "Refund policy label",
      "default": "Refund Policy"
    },
    {
      "type": "text",
      "id": "label_shipping",
      "label": "Shipping policy label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "label_privacy",
      "label": "Privacy policy label",
      "default": "Privacy"
    },
    {
      "type": "text",
      "id": "label_terms",
      "label": "Terms policy label",
      "default": "Terms"
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Policy link gap (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Policy link color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Policy link hover color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "text",
      "id": "discord_url",
      "label": "Discord URL"
    },
    {
      "type": "range",
      "id": "social_size",
      "label": "Social icon size (px)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 22
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social icon color",
      "default": "#19d400"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Get this store design"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button background",
      "default": "#19d400"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "Button radius (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "Show copyright",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright name (default: store name)"
    },
    {
      "type": "color",
      "id": "copyright_color",
      "label": "Copyright text color",
      "default": "#6b7280"
    },
    {
      "type": "header",
      "content": "Footer layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Top border color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (px)",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 40
    },
    {
      "type": "header",
      "content": "Extra appearance controls"
    },
    {
      "type": "color",
      "id": "section_surface",
      "label": "Section background"
    },
    {
      "type": "select",
      "id": "mobile_spacing_mode",
      "label": "Mobile section spacing",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Use section spacing"
        },
        {
          "value": "custom",
          "label": "Custom mobile spacing"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_bottom_override",
      "label": "Mobile bottom spacing (px; -1 = default)",
      "min": -1,
      "max": 199,
      "step": 2,
      "default": -1
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "bottom_gap",
      "label": "Copyright to badge gap",
      "min": 4,
      "max": 32,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
