<section class="vx-shell vx-shell--header" data-vx-section="header">
  <div class="vx-editor-preview"></div>
</section>

<script type="application/json" data-vx-settings="header">
{
  "logo_url": {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 800 | json }}{% elsif section.settings.use_reference_logo %}{{ 'lin-logo.png' | asset_url | json }}{% else %}null{% endif %},
  "logo_width_desktop": {{ section.settings.logo_width_desktop | default: 120 }},
  "logo_width_mobile": {{ section.settings.logo_width_mobile | default: 120 }},
  "brand_text": {{ section.settings.brand_text | default: shop.name | json }},
  "brand_color": {{ section.settings.brand_color | default: '#ffffff' | json }},
  "nav_color": {{ section.settings.nav_color | default: '#d1d5db' | json }},
  "nav_hover_color": {{ section.settings.nav_hover_color | default: '#19d400' | json }},
  "show_products_link": {{ section.settings.show_products_link | json }},
  "use_menu": {{ section.settings.use_menu | json }},
  "home_label": {{ section.settings.home_label | default: 'Home' | json }},
  "products_label": {{ section.settings.products_label | default: 'Products' | json }},
  "products_url": {{ section.settings.products_url | default: '/' | json }},
  "scroll_bg": {{ section.settings.scroll_bg | default: '#000000' | json }},
  "scroll_border": {{ section.settings.scroll_border | default: '#1a1a1a' | json }},
  "dropdown_bg": {{ section.settings.dropdown_bg | default: '#0a0a0a' | json }},
  "badge_bg": {{ section.settings.badge_bg | default: '#19d400' | json }},
  "badge_text_color": {{ section.settings.badge_text_color | default: '#000000' | json }},
  "header_height_desktop": {{ section.settings.header_height_desktop | default: 64 }},
  "header_height_mobile": {{ section.settings.header_height_mobile | default: 48 }},
  "nav_gap": {{ section.settings.nav_gap | default: 32 }},
  "side_padding_desktop": {{ section.settings.side_padding_desktop | default: 28 }},
  "side_padding_mobile": {{ section.settings.side_padding_mobile | default: 16 }},
  "scroll_threshold": {{ section.settings.scroll_threshold | default: 50 }},
  "scroll_blur": {{ section.settings.scroll_blur | default: 12 }},
  "nav_links": [
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        {"title":{{ link.title | json }},"url":{{ link.url | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endif -%}
  ]
}
</script>

<style>
  .vx-shell--header{min-height:auto;position:fixed;top:var(--urgency-bar-height,0px);left:0;right:0;z-index:999;background:transparent;display:block}
</style>

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "header-section",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "checkbox", "id": "use_reference_logo", "label": "Use bundled Lin reference logo", "default": false },
    { "type": "range", "id": "logo_width_desktop", "label": "Logo width desktop (px)", "min": 80, "max": 500, "step": 10, "default": 120 },
    { "type": "range", "id": "logo_width_mobile",  "label": "Logo width mobile (px)",  "min": 60, "max": 260, "step": 10, "default": 120 },
    { "type": "text",  "id": "brand_text", "label": "Brand text (if no logo)", "default": "OGSELL" },
    { "type": "color", "id": "brand_color", "label": "Brand text color", "default": "#ffffff" },

    { "type": "header", "content": "Navigation" },
    { "type": "checkbox", "id": "show_products_link", "label": "Show Products link", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "use_menu", "label": "Use selected menu links", "default": false },
    { "type": "text", "id": "home_label", "label": "Home link label", "default": "Home" },
    { "type": "text", "id": "products_label", "label": "Products link label", "default": "Products" },
    { "type": "url", "id": "products_url", "label": "Products link destination" },
    { "type": "color", "id": "nav_color",       "label": "Nav link color",  "default": "#d1d5db" },
    { "type": "color", "id": "nav_hover_color", "label": "Nav hover color", "default": "#19d400" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "scroll_bg",     "label": "Scroll background",       "default": "#000000" },
    { "type": "color", "id": "scroll_border", "label": "Scroll border color",     "default": "#1a1a1a" },
    { "type": "range", "id": "scroll_threshold", "label": "Solid header after (px)", "min": 10, "max": 200, "step": 10, "default": 50 },
    { "type": "range", "id": "scroll_blur", "label": "Scrolled blur (px)", "min": 0, "max": 20, "step": 2, "default": 12 },
    { "type": "color", "id": "dropdown_bg",   "label": "Mobile dropdown bg",      "default": "#0a0a0a" },
    { "type": "color", "id": "badge_bg",      "label": "Cart badge background",   "default": "#19d400" },
    { "type": "color", "id": "badge_text_color", "label": "Cart badge text",      "default": "#000000" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "header_height_desktop", "label": "Height desktop (px)", "min": 50, "max": 120, "step": 2, "default": 64 },
    { "type": "range", "id": "header_height_mobile",  "label": "Height mobile (px)",  "min": 44, "max": 90,  "step": 2, "default": 48 },
    { "type": "range", "id": "nav_gap", "label": "Desktop link gap (px)", "min": 12, "max": 48, "step": 2, "default": 32 },
    { "type": "range", "id": "side_padding_desktop", "label": "Desktop side padding (px)", "min": 16, "max": 48, "step": 2, "default": 28 },
    { "type": "range", "id": "side_padding_mobile", "label": "Mobile side padding (px)", "min": 8, "max": 32, "step": 2, "default": 16 }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
