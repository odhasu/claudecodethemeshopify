{% style %}
  #shopify-section-{{ section.id }} .lin-access {
    box-sizing: border-box;
    max-width: {{ section.settings.max_width }}px;
    margin-inline: auto;
    padding-inline: {{ section.settings.gutter }}px;
  }
  #shopify-section-{{ section.id }} .lin-access__inner {
    padding: {{ section.settings.padding }}px;
    border-radius: {{ section.settings.radius }}px;
    background: {{ section.settings.background }};
    text-align: center;
  }
  #shopify-section-{{ section.id }} .lin-access__heading {
    margin: 0 0 {{ section.settings.heading_gap }}px;
    color: {{ section.settings.heading_color }};
    font-family: var(--font-{{ section.settings.heading_font }}, inherit);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    letter-spacing: normal;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .lin-access__text {
    margin: 0 0 {{ section.settings.text_gap }}px;
    color: {{ section.settings.text_color }};
    font-family: var(--font-{{ section.settings.text_font }}, inherit);
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .lin-access__button {
    display: inline-block;
    box-sizing: border-box;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_color }};
    font-family: var(--font-{{ section.settings.button_font }}, inherit);
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    line-height: {{ section.settings.button_line_height }}px;
    text-decoration: none;
    transition: background-color {{ section.settings.transition_ms }}ms ease, color {{ section.settings.transition_ms }}ms ease, transform {{ section.settings.transition_ms }}ms ease;
  }
  #shopify-section-{{ section.id }} .lin-access__button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_color }};
    transform: translateY(-{{ section.settings.hover_lift }}px);
  }
  #shopify-section-{{ section.id }} .lin-access__button:focus-visible {
    outline: 2px solid {{ section.settings.heading_color }};
    outline-offset: 4px;
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .lin-access {
      padding-inline: {{ section.settings.mobile_gutter }}px;
    }
    #shopify-section-{{ section.id }} .lin-access__inner {
      padding: {{ section.settings.mobile_padding }}px;
    }
    #shopify-section-{{ section.id }} .lin-access__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }
    #shopify-section-{{ section.id }} .lin-access__text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .lin-access__button { transition: none; }
    #shopify-section-{{ section.id }} .lin-access__button:hover { transform: none; }
  }
{% endstyle %}

<div class="lin-access">
  <div class="lin-access__inner">
    {% if section.settings.heading != blank %}
      <h2 class="lin-access__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="lin-access__text">{{ section.settings.text | escape | newline_to_br }}</p>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_url != blank %}
      <a class="lin-access__button" href="{{ section.settings.button_url | escape }}">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Lin supplier access",
  "tag": "section",
  "class": "lin-access-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Access My Personal Suppliers 💕" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Reliable & Quick!" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Access" },
    { "type": "url", "id": "button_url", "label": "Button link", "default": "/" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 600, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "gutter", "label": "Desktop outer gutter", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_gutter", "label": "Mobile outer gutter", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding", "label": "Desktop inner padding", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile inner padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "radius", "label": "Container corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "background", "label": "Background", "default": "#000000" },
    { "type": "header", "content": "Heading" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "select", "id": "heading_font", "label": "Heading font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 16, "max": 64, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 12, "max": 32, "step": 0.2, "unit": "px", "default": 25.6 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }, { "value": "900", "label": "Black" }], "default": "700" },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 120 },
    { "type": "range", "id": "heading_gap", "label": "Space below heading", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Text" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#9ca3af" },
    { "type": "select", "id": "text_font", "label": "Text font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
    { "type": "range", "id": "text_size", "label": "Desktop text size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "mobile_text_size", "label": "Mobile text size", "min": 12, "max": 24, "step": 0.2, "unit": "px", "default": 16.2 },
    { "type": "select", "id": "text_weight", "label": "Text weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "700", "label": "Bold" }], "default": "400" },
    { "type": "range", "id": "text_line_height", "label": "Text line height", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 140 },
    { "type": "range", "id": "text_gap", "label": "Space below text", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "Button" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ff86dd" },
    { "type": "color", "id": "button_color", "label": "Button text", "default": "#000000" },
    { "type": "color", "id": "button_hover_background", "label": "Button hover background", "default": "#ff60ae" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover text", "default": "#000000" },
    { "type": "select", "id": "button_font", "label": "Button font", "options": [{ "value": "body", "label": "Body font" }, { "value": "heading", "label": "Heading font" }], "default": "body" },
    { "type": "range", "id": "button_size", "label": "Button text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "button_weight", "label": "Button weight", "options": [{ "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }, { "value": "900", "label": "Black" }], "default": "600" },
    { "type": "range", "id": "button_line_height", "label": "Button line height", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "button_padding_y", "label": "Button vertical padding", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_padding_x", "label": "Button horizontal padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "hover_lift", "label": "Button hover lift", "min": 0, "max": 10, "step": 1, "unit": "px", "default": 2 },
    { "type": "range", "id": "transition_ms", "label": "Button transition duration", "min": 0, "max": 1000, "step": 50, "unit": "ms", "default": 300 }
  ],
  "presets": [{ "name": "Lin supplier access" }]
}
{% endschema %}
