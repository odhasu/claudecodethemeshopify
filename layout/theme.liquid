<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background | default: '#000000' }}">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preload" href="{{ 'scaled-loader-current.js' | asset_url }}" as="script">
  <script>
    if (window.location.pathname.replace(/\/$/, '') === '/collections/all') {
      window.location.replace('/');
    }
  </script>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {% render 'meta-tags' %}

  {{ content_for_header }}

  {%- liquid
    assign accent = settings.color_accent | default: '#19d400'
    assign accent_hover = settings.color_accent_hover | default: '#15b800'
    assign brand_name = settings.brand_name | default: shop.name
    if brand_name == 'Vexel'
      assign brand_name = shop.name
    endif
    assign bg = settings.color_background | default: '#000000'
    assign card_bg = settings.color_card_bg | default: '#111111'
    assign card_elevated = settings.color_card_elevated | default: '#1a1a1a'
    assign border_color = settings.color_border | default: '#2a2a2a'
    assign text_primary = settings.color_text_primary | default: '#ffffff'
    assign text_muted = settings.color_text_muted | default: '#9ca3af'
    assign text_subtle = settings.color_text_subtle | default: '#6b7280'
    assign star_color = settings.color_stars | default: '#fbbf24'
    assign heading_font = settings.heading_font | default: 'Clash Grotesk'
    assign body_font = settings.body_font | default: 'Satoshi'
  -%}

  {% if heading_font == 'Clash Grotesk' or heading_font == 'Satoshi' or body_font == 'Clash Grotesk' or body_font == 'Satoshi' %}
  <link rel="preconnect" href="https://api.fontshare.com">
  <link href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400,500,600,700&f[]=satoshi@400,500,700,900&display=swap" rel="stylesheet">
  {% endif %}

  {%- capture extra_fonts -%}
    {%- unless heading_font == 'Clash Grotesk' or heading_font == 'Satoshi' or heading_font contains 'system-ui' -%}family={{ heading_font | replace: ' ', '+' }}{% unless heading_font == 'Anton' or heading_font == 'Bebas Neue' %}:wght@400;500;600;700{% endunless %}&{%- endunless -%}
    {%- unless body_font == 'Satoshi' or body_font == 'Clash Grotesk' or body_font contains 'system-ui' or body_font == heading_font -%}family={{ body_font | replace: ' ', '+' }}:wght@400;500;600;700&{%- endunless -%}
  {%- endcapture -%}
  {%- if extra_fonts != blank -%}
    <link href="https://fonts.googleapis.com/css2?{{ extra_fonts }}display=swap" rel="stylesheet">
  {%- endif -%}

  <script>window.VexelConfig={colors:{accent1:{{ accent | json }},background:{{ bg | json }},text:{{ text_primary | json }},textMuted:{{ text_muted | json }},cardBg:{{ card_bg | json }},border:{{ border_color | json }}},brandName:{{ brand_name | json }},logoUrl:{% if settings.logo %}{{ settings.logo | image_url: width: 400 | json }}{% else %}null{% endif %},loading:{minimum:{{ settings.loader_minimum_ms | default: 0 | json }},fallback:{{ settings.loader_fallback_ms | default: 3000 | json }},fade:{{ settings.loader_fade_ms | default: 200 | json }}}};</script>

  <style>
    :root {
      --dialog-radius: {{ settings.dialog_radius | default: 16 }}px;
      --dialog-padding: {{ settings.dialog_padding | default: 32 }}px;
      --dialog-overlay-opacity: {{ settings.dialog_overlay_opacity | default: 50 | times: 0.01 }};
      --dialog-title-size: {{ settings.dialog_title_size | default: 20 }}px;
      --dialog-body-size: {{ settings.dialog_body_size | default: 15 }}px;
      --dialog-bg: {{ settings.dialog_bg | default: '#111111' }};
      --dialog-border: {{ settings.dialog_border | default: '#333333' }};
      --product-title-size: {{ settings.product_title_size | default: 16 }}px;
      --product-title-size-mobile: {{ settings.product_title_size_mobile | default: 14 }}px;
      --product-price-size-mobile: {{ settings.product_price_size_mobile | default: 17 }}px;
      --product-price-size: {{ settings.product_price_size | default: 18 }}px;
      --product-compare-size: {{ settings.product_compare_size | default: 14 }}px;
      --product-image-fit: {{ settings.product_image_fit | default: 'cover' }};
      --product-image-zoom: {{ settings.product_image_zoom | default: 103 | times: 0.01 }};
      --product-description-lines: {{ settings.product_description_lines | default: 2 }};
      --product-border-width: {{ settings.product_border_width | default: 1 }}px;
      --info-button-bg: {{ settings.info_button_bg | default: '#2a2a2a' }};
      --info-button-color: {{ settings.info_button_color | default: '#b3b3b3' }};
      --info-button-radius: {{ settings.info_button_radius | default: 10 }}px;
      --buy-button-height: {{ settings.buy_button_height | default: 48 }}px;
      --buy-button-height-mobile: {{ settings.buy_button_height_mobile | default: 42 }}px;
      --buy-button-size: {{ settings.buy_button_size | default: 22 }}px;
      --buy-button-size-mobile: {{ settings.buy_button_size_mobile | default: 13 }}px;
      --button-hover-lift: {{ settings.button_hover_lift | default: 2 }}px;
      --hero-button-size: {{ settings.hero_button_size | default: 16 }}px;
      --hero-button-padding-y: {{ settings.hero_button_padding_y | default: 16 }}px;
      --hero-button-padding-x: {{ settings.hero_button_padding_x | default: 40 }}px;
      --footer-button-size: {{ settings.footer_button_size | default: 12 }}px;
      --footer-button-padding-y: {{ settings.footer_button_padding_y | default: 8 }}px;
      --header-content-width: {{ settings.header_content_width | default: 1310 }}px;
      --header-brand-size: {{ settings.header_brand_size | default: 22 }}px;
      --header-nav-size: {{ settings.header_nav_size | default: 14 }}px;
      --header-nav-opacity: {{ settings.header_nav_opacity | default: 50 | times: 0.01 }};
      --header-initial-bg: {{ settings.header_initial_bg | default: '#000000' }};
      --header-initial-opacity: {{ settings.header_initial_opacity | default: 0 | times: 0.01 }};
      --reveal-duration: {{ settings.reveal_duration | default: 600 }}ms;
      --reveal-distance: {{ settings.reveal_distance | default: 20 }}px;
      --input-radius: {{ settings.input_radius | default: 10 }}px;
      --input-background: {{ settings.input_background | default: '#1a1a1a' }};
      --input-border: {{ settings.input_border | default: '#333333' }};
      --smooth-scroll: {% if settings.smooth_scroll == false %}auto{% else %}smooth{% endif %};
      --color-accent: {{ accent }};
      --color-accent-hover: {{ accent_hover }};
      --color-accent-rgb: {{ accent | color_extract: 'red' }}, {{ accent | color_extract: 'green' }}, {{ accent | color_extract: 'blue' }};
      --color-bg: {{ bg }};
      --color-card-bg: {{ card_bg }};
      --color-card-elevated: {{ card_elevated }};
      --color-border: {{ border_color }};
      --color-text: {{ text_primary }};
      --color-text-muted: {{ text_muted }};
      --color-text-subtle: {{ text_subtle }};
      --color-stars: {{ star_color }};
      --font-heading: {% if heading_font contains 'system-ui' %}{{ heading_font }}{% else %}'{{ heading_font }}', 'Clash Grotesk', sans-serif{% endif %};
      --font-body: {% if body_font contains 'system-ui' %}{{ body_font }}{% else %}'{{ body_font }}', 'Satoshi', sans-serif{% endif %};
      --radius-card: {{ settings.border_radius_card | default: 12 }}px;
      --radius-button: {{ settings.border_radius_button | default: 8 }}px;
      --max-width: {{ settings.max_page_width | default: 1200 }}px;
      --section-spacing: {{ settings.section_spacing | default: 60 }}px;
      --grid-gap: {{ settings.grid_gap | default: 16 }}px;
      --grid-gap-mobile: {{ settings.grid_gap_mobile | default: 16 }}px;
      --homepage-inline-padding: {{ settings.homepage_inline_padding | default: 16 }}px;
      --homepage-glow-rgb: {{ settings.homepage_glow_color | default: accent | color_extract: 'red' }}, {{ settings.homepage_glow_color | default: accent | color_extract: 'green' }}, {{ settings.homepage_glow_color | default: accent | color_extract: 'blue' }};
      --homepage-glow-opacity: {% if settings.homepage_glow_enabled == false %}0{% else %}{{ settings.homepage_glow_intensity | default: 10 | times: 0.01 }}{% endif %};
      --homepage-glow-opacity-left: calc(var(--homepage-glow-opacity) * {{ settings.homepage_glow_left_strength | default: 100 | times: 0.01 }});
      --homepage-glow-opacity-right: calc(var(--homepage-glow-opacity) * {{ settings.homepage_glow_right_strength | default: 100 | times: 0.01 }});
      --homepage-glow-opacity-bottom: calc(var(--homepage-glow-opacity) * {{ settings.homepage_glow_bottom_strength | default: 100 | times: 0.01 }});
      --homepage-glow-width-1: {{ settings.homepage_glow_spread | default: 100 | times: 8 }}px;
      --homepage-glow-height-1: {{ settings.homepage_glow_spread | default: 100 | times: 5 }}px;
      --homepage-glow-width-2: {{ settings.homepage_glow_spread | default: 100 | times: 7 }}px;
      --homepage-glow-height-2: {{ settings.homepage_glow_spread | default: 100 | times: 4.5 }}px;
      --homepage-glow-width-3: {{ settings.homepage_glow_spread | default: 100 | times: 9 }}px;
      --homepage-glow-height-3: {{ settings.homepage_glow_spread | default: 100 | times: 6 }}px;
      --body-text-size: {{ settings.body_text_size | default: 16 }}px;
      --body-line-height: {{ settings.body_line_height | default: 15 | times: 0.1 }};
      --product-dialog-width: {{ settings.product_dialog_width | default: 480 }}px;
      --product-dialog-blur: {{ settings.product_dialog_blur | default: 4 }}px;
      --review-dialog-width: {{ settings.review_dialog_width | default: 480 }}px;
      --review-dialog-blur: {{ settings.review_dialog_blur | default: 4 }}px;
      --loader-spinner-size: {{ settings.loader_spinner_size | default: 48 }}px;
      --loader-spinner-color: {{ settings.loader_spinner_color | default: '#19d400' }};
      --loader-fade: {{ settings.loader_fade_ms | default: 200 }}ms;
      --urgency-bar-height: 0px;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-full: 9999px;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.5);
      --shadow-md: 0 4px 12px rgba(0,0,0,0.5);
      --shadow-lg: 0 8px 24px rgba(0,0,0,0.5);
      --shadow-glow: 0 0 20px color-mix(in srgb, var(--color-accent) 30%, transparent);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: var(--smooth-scroll);
      scrollbar-width: {% if settings.show_scrollbars %}auto{% else %}none{% endif %};
    }
    {% unless settings.show_scrollbars %}html::-webkit-scrollbar { display: none; }{% endunless %}

    body {
      font-family: var(--font-body);
      background-color: var(--color-bg);
      color: var(--color-text);
      font-size: var(--body-text-size);
      line-height: var(--body-line-height);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }
    button { cursor: pointer; border: none; background: none; font-family: inherit; }

    .container {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 20px;
    }

    .section-spacing { padding: var(--section-spacing) 0; }

    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* Shell states — full-page loader handles visibility */
    .vx-shell--loading .vx-editor-preview { display: none; }
    .vx-shell:not(.vx-shell--loading) .vx-editor-preview { display: none; }

    /* Loading overlay */
    body.is-loading { overflow: hidden !important; }
    body.is-loading > *:not(.vx-loader) { visibility: hidden; }

    .vx-loader {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 99999;
      background: var(--color-bg, #000);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity var(--loader-fade) cubic-bezier(0.4, 0, 0.2, 1), visibility var(--loader-fade);
    }
    .vx-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .vx-loader__spinner {
      width: var(--loader-spinner-size);
      height: var(--loader-spinner-size);
      position: relative;
    }
    .vx-loader__spinner::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 3px solid transparent;
      border-top-color: var(--loader-spinner-color);
      border-right-color: var(--loader-spinner-color);
      animation: vxSpin 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
    }
    .vx-loader__spinner::after {
      content: '';
      position: absolute;
      inset: 6px;
      border-radius: 50%;
      border: 2px solid transparent;
      border-bottom-color: var(--loader-spinner-color);
      border-left-color: var(--loader-spinner-color);
      animation: vxSpin 0.8s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite reverse;
    }
    @keyframes vxSpin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {%- if settings.custom_css != blank -%}
    <style>{{ settings.custom_css }}</style>
  {%- endif -%}

  {%- if settings.custom_head_code != blank -%}
    {{ settings.custom_head_code }}
  {%- endif -%}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %} is-loading{% if settings.button_shadows == false %} no-button-shadows{% endif %}{% if settings.motion_enabled == false %} motion-disabled{% endif %}{% if settings.marquee_enabled == false %} marquee-disabled{% endif %}{% if settings.header_mobile_cart %} mobile-cart-visible{% endif %}{% if settings.header_nav_position == 'right' %} nav-position-right{% endif %}">
  <div class="vx-loader" id="vx-loader" aria-label="Loading"><div class="vx-loader__spinner"></div></div>

  <a class="sr-only" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}

  {% render 'live-sales-notification' %}

  <script src="{{ 'scaled-loader-current.js' | asset_url }}" defer></script>


  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {%- if settings.custom_js != blank -%}
    <script>{{ settings.custom_js }}</script>
  {%- endif -%}
</body>
</html>
