{%- comment -%}Optional section overrides are scoped to this Shopify section instance.{%- endcomment -%}
<style>
  {%- if section.settings.section_surface != blank -%}
    #shopify-section-{{ section.id }} { background: {{ section.settings.section_surface }}; }
    #shopify-section-{{ section.id }} :is(.vx-hero,.vx-pg,.vx-testimonials,.vx-faq,.vx-reviews,.vx-footer,.results-section,.bundle-section) { background-color: {{ section.settings.section_surface }} !important; }
  {%- endif -%}
  #shopify-section-{{ section.id }} { --section-title-scale: {{ section.settings.section_title_scale | default: 100 | times: 0.01 }}; }
  {%- if section.settings.section_heading_align != 'inherit' and section.settings.section_heading_align != blank -%}
    #shopify-section-{{ section.id }} :is(h1,h2,.vx-reviews__heading,.results-header) { text-align: {{ section.settings.section_heading_align }} !important; }
  {%- endif -%}
  {%- if section.settings.mobile_spacing_mode == 'custom' -%}
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} :is(.vx-hero,.vx-pg,.vx-testimonials,.vx-faq,.vx-reviews,.vx-footer,.results-section,.bundle-section) {
        padding-top: {{ section.settings.mobile_padding_top }}px !important;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
      }
    }
  {%- endif -%}
</style>
